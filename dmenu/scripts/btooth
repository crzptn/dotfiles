#!/usr/bin/env bash

# simple bluetooth dmenu manager (fixed pairing + connect flow)

set -u

DMENU="${DMENU_CMD:-dmenu -i -l 12}"

command -v bluetoothctl >/dev/null 2>&1 || {
  echo "bluetoothctl not found" >&2
  exit 1
}

bluetoothctl power on >/dev/null 2>&1 || true

is_connected() {
  bluetoothctl info "$1" 2>/dev/null | grep -q '^Connected: yes$'
}

is_paired() {
  bluetoothctl paired-devices | grep -q "$1"
}

# scan briefly
bluetoothctl scan on >/dev/null 2>&1 &
scan_pid=$!
sleep 4
kill "$scan_pid" >/dev/null 2>&1 || true

devices="$(
  bluetoothctl devices | while read -r _ mac name_rest; do
    [ -n "${mac:-}" ] || continue
    name="${name_rest:-Unknown}"

    status=""
    is_connected "$mac" && status="$status connected"
    is_paired "$mac" && status="$status paired"
    [ -z "$status" ] && status=" available"

    printf '%s | %s |%s\n' "$mac" "$name" "$status"
  done
)"

[ -n "${devices:-}" ] || exit 1

device_choice="$(printf '%s\n' "$devices" | eval "$DMENU -p 'Bluetooth device:'")"
[ -n "${device_choice:-}" ] || exit 0

mac="${device_choice%% | *}"

# actions
actions="connect disconnect forget"
if ! is_paired "$mac"; then
  actions="pair $actions"
fi

action="$(printf '%s\n' $actions | eval "$DMENU -p 'Action:'")"
[ -n "${action:-}" ] || exit 0

case "$action" in
  pair)
    bluetoothctl pair "$mac" || true
    ;;

  connect)
    if ! is_paired "$mac"; then
      bluetoothctl pair "$mac" || true
    fi
    bluetoothctl trust "$mac" >/dev/null 2>&1 || true
    bluetoothctl connect "$mac"
    ;;

  disconnect)
    bluetoothctl disconnect "$mac"
    ;;

  forget)
    bluetoothctl remove "$mac"
    ;;
esac
